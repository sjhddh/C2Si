{
  "name": "c2si",
  "version": "0.1.0",
  "description": "Carbon-to-Silicon: Compress human language into token-efficient notation for LLMs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest run tests/benchmark.test.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "llm",
    "token",
    "compression",
    "prompt",
    "ai",
    "semantic",
    "scn",
    "context"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JiahaoRBC/C2Si"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
